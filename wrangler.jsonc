// The real deployment: one Worker serves the app and its API, with the shop in D1.
// Before the first deploy, see "Run it for a real shop" in the README.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mawid",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Served at https://mawid.<account>.workers.dev; no per-version preview links.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-server",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mawid",
      // From `wrangler d1 create mawid`. A new client gets its own database and id.
      "database_id": "e2641177-ceb9-42d7-9a5b-b590952167b4",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
